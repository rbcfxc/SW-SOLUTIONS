# =========================================================
# Metsing.store — Stitch Money API Environment Variables
# Copy this file to .env for local testing, or add these
# variables in Render Dashboard -> Environment.
# NEVER commit your real .env file to Git.
# =========================================================

# Server port (Render sets PORT automatically)
PORT=3000

# Public base URL of your live site (no trailing slash)
PUBLIC_BASE_URL=https://sw-solutions-cb1x.onrender.com

# Stitch OAuth2 Client Credentials (from Stitch Dashboard)
STITCH_CLIENT_ID=your_stitch_client_id_here
STITCH_CLIENT_SECRET=your_stitch_client_secret_here

# Stitch Beneficiary Bank Account (where customer payments settle)
# Allowed STITCH_BENEFICIARY_BANK_ID values in South Africa:
#   absa | african_bank | bidvest | capitec | discovery | fnb
#   investec | nedbank | sasfin | standard_bank | tymebank
STITCH_BENEFICIARY_NAME=Metsing Store
STITCH_BENEFICIARY_BANK_ID=fnb
STITCH_BENEFICIARY_ACCOUNT_NUMBER=00000000000

# Optional: Stitch Token & GraphQL URLs (defaults shown)
STITCH_TOKEN_URL=https://secure.stitch.money/connect/token
STITCH_GRAPHQL_URL=https://api.stitch.money/graphql
